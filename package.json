{
  "name": "greenline",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering skills and durable project evidence for coding agents, offline, with an optional connector to garden.",
  "keywords": [
    "agent-skills",
    "claude-code",
    "cli",
    "codex",
    "coding-agents",
    "markdown"
  ],
  "homepage": "https://fernworks.dev/greenline/",
  "license": "MIT",
  "author": "fernworks <admin@fernworks.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fern-works/greenline.git"
  },
  "bin": {
    "greenline": "dist/bin/greenline.mjs"
  },
  "files": [
    "dist/bin",
    "dist/corpus",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "provenance",
    "assets/inspect-fonts/OFL.txt"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown && node scripts/build-installation.mjs && node scripts/build-package.mjs",
    "prepack": "node scripts/build-package.mjs --refuse-root-pack",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full",
    "fmt": "oxfmt",
    "lint": "oxlint .",
    "test": "vitest run --passWithNoTests",
    "skills:sync": "node scripts/skills-sync.mjs",
    "site": "node scripts/build-site.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "17.4.3",
    "jscpd": "4.3.0",
    "knip": "5.88.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.78.0",
    "tsdown": "0.12.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1"
}
